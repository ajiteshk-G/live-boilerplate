# Copy to .env and fill in. The loader reads this automatically.
# .env is gitignored; never commit real values.

# --- required ---------------------------------------------------------------
# The Vertex AI project the Live session runs against.
GOOGLE_CLOUD_PROJECT=your-project-id

# --- optional ---------------------------------------------------------------
# Referenced by config/config.yaml as ${VAR}. Uncomment what you use.

# Overrides vertex.location if you wire it into the config.
# GOOGLE_CLOUD_LOCATION=us-central1

# Credentials for an HTTP/SSE MCP server, referenced from tools.mcp[].headers.
# DOCS_MCP_TOKEN=

# Authentication note: this project uses Application Default Credentials, not
# an API key. Run `gcloud auth application-default login` once. There is
# deliberately no GOOGLE_API_KEY here -- that is the Developer API path, which
# this Vertex-only boilerplate does not use.
